{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "generate": "fumadocs-mdx && tsx ../../tooling/sync-registry-public.ts && tsx ../../tooling/build-figma-kit.ts && tsx ../../tooling/build-theme-exports.ts && tsx ../../tooling/build-docs-metadata.ts && tsx ../../tooling/build-pro-placeholders.ts",
    "postinstall": "fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:visual": "PLAYWRIGHT_VISUAL=1 playwright test --project=visual",
    "test:visual:update": "PLAYWRIGHT_VISUAL=1 playwright test --project=visual --update-snapshots",
    "test:visual:docker": "bash ../../tooling/visual-docker.sh",
    "test:visual:docker:update": "bash ../../tooling/visual-docker.sh --update-snapshots",
    "visual:contact-sheet": "tsx e2e/visual/contact-sheet.ts"
  },
  "dependencies": {
    "@hewnui/docs-metadata": "workspace:*",
    "@hewnui/registry": "workspace:*",
    "@hewnui/themes": "workspace:*",
    "@hewnui/ui": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-table": "8.21.3",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.11.5",
    "motion": "12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hewnui/tsconfig": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/mdx": "2.0.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jest-axe": "^11.0.0",
    "jsdom": "28.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
