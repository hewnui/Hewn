# Canonical site origin (optional; Vercel URL / @hewnui/site-url used otherwise)
# Default is https://hewnui.dev. Until that DNS is live, deploys can pin the old host:
# NEXT_PUBLIC_SITE_URL=https://komponents-dev.vercel.app
# HEWN_SITE_URL=https://komponents-dev.vercel.app

# Pro surface mode: waitlist (default) | preorder
# PRO_MODE=waitlist

# Required only when PRO_MODE=preorder — refuse to render checkout if unset.
# Never commit a live price. Leave blank so nothing shows a price by accident.
# PRO_PREORDER_PRICE_DISPLAY=

# Upstash Redis for Pro waitlist (also accepted: UPSTASH_REDIS_REST_URL / _TOKEN)
# Provision on Vercel (prod + preview). Without these in production the waitlist
# route fails closed with "Waitlist temporarily unavailable."
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local/CI only — in-memory waitlist when Redis env is unset (Playwright sets this).
# Never enable on Vercel.
# HEWN_WAITLIST_MEMORY=1
