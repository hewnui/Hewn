{
  "name": "@hewnui/docs-metadata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./install": {
      "types": "./src/install.ts",
      "default": "./src/install.ts"
    },
    "./distribution": {
      "types": "./src/distribution.ts",
      "default": "./src/distribution.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "tsx ../../tooling/build-docs-metadata.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@hewnui/tsconfig": "workspace:*",
    "@types/node": "26.1.1",
    "tsx": "^4.23.1",
    "vitest": "4.1.10"
  }
}
