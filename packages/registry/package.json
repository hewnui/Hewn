{
  "name": "@hewnui/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./categories": {
      "types": "./src/categories.ts",
      "default": "./src/categories.ts"
    },
    "./jsx": {
      "types": "./src/jsx.ts",
      "default": "./src/jsx.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "tsx ../../tooling/build-registry.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@hewnui/tsconfig": "workspace:*",
    "@types/node": "26.1.1",
    "shadcn": "^4.22.1",
    "tsx": "^4.23.1",
    "vitest": "4.1.10"
  }
}
