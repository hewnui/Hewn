{
  "extends": "@hewnui/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": [
    "src/test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.examples.tsx",
    "src/**/*.registry.ts",
    "src/**/*.ai.ts"
  ]
}
